# Variables de entorno para S'TILOS GISSEL
# En Vercel: Configurar en Project Settings -> Environment Variables
# Para desarrollo local con Vercel CLI: ejecutar `vercel env pull` o copiar a .env.local

VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Clave gratuita de Google Gemini (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu-clave-gemini-aqui
VITE_GEMINI_API_KEY=tu-clave-gemini-aqui
